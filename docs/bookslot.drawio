          <mxGeometry x="170" y="415" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q5i" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q5" value="5 · El authorizer valida el token&#xa;si no vale, 401 y la funcion NO se invoca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="170" y="510" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q6i" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="100" y="615" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q6" value="6 · La funcion lee la franja (lectura consistente)&#xa;para dar 404 si no existe y copiar lo que necesita el aviso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="170" y="605" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q7i" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="100" y="715" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q7" value="7 · TransactWriteItems&#xa;descontar la plaza · crear la reserva · marcar la clave&#xa;TODO O NADA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B45309;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="170" y="700" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qe_q1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe_q2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q2" target="q3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe_q3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q3" target="q4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe_q4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q4" target="q5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe_q5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q5" target="q6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe_q6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="q6" target="q7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="201 Created&#xa;&#xa;La reserva es nueva. Devuelve la reserva y las&#xa;plazas que quedan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="200 OK&#xa;&#xa;La clave de idempotencia ya existia: es el MISMO&#xa;intento repetido. Devuelve la reserva original.&#xa;Dice «ya la tenias», no «te he dado otra»." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="800" y="690" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="409 Conflict&#xa;&#xa;SLOT_SOLD_OUT · no quedan plazas&#xa;SLOT_BLOCKED · la franja no admite reservas&#xa;ALREADY_RESERVED · ya tenia una en esa franja" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="800" y="830" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fe1" value="se cumplen las tres" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;strokeColor=#7AA116;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7" target="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe2" value="falla la 3.a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe3" value="falla la 1.a o la 2.a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;strokeColor=#DD344C;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q7" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_pru" value="LAS PRUEBAS&#xa;&#xa;concurrency-test.sh lanza N peticiones que se&#xa;liberan a la vez con una barrera, todas sobre la&#xa;misma franja de M plazas.&#xa;&#xa;Lo que se exige: exactamente M respuestas 201 y&#xa;N-M respuestas 409, y reserved_count = M al&#xa;terminar. Ni una plaza de mas.&#xa;&#xa;idempotency-test.sh manda 20 peticiones con la&#xa;MISMA clave: 1 respuesta 201, 19 respuestas 200,&#xa;y una sola reserva en la tabla." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#232F3E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="420" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="auth" name="3 · Identidad y autorizacion">
    <mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_auth" value="BookSlot — identidad y autorizacion" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_auth" value="El reparto: EL GATEWAY AUTENTICA (¿es este token autentico y vigente?) Y LA FUNCION AUTORIZA (¿puede este usuario hacer esto?)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_nav" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="130" y="190" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_nav" value="Navegador&#xa;&#xa;SignUp · ConfirmSignUp · InitiateAuth&#xa;&#xa;Llamadas NO firmadas: el cliente de&#xa;Cognito es publico y no tiene secreto,&#xa;asi que no hace falta ninguna&#xa;credencial de AWS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v_cog" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="550" y="190" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_cog" value="Cognito User Pool&#xa;&#xa;Custodia las contrasenas y su politica.&#xa;Emite el JWT con las claims:&#xa;&#xa;    sub · el id del usuario&#xa;    email · name&#xa;    cognito:groups · p. ej. [admins]&#xa;    iss · aud · exp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="430" y="250" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v_gw" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="220" y="500" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_gw" value="API Gateway · authorizer JWT nativo&#xa;&#xa;Comprueba, ANTES de invocar la funcion:&#xa;&#xa;    · la firma, contra el JWKS del emisor&#xa;    · el emisor (iss) y la audiencia (aud)&#xa;    · la caducidad (exp)&#xa;&#xa;Si algo falla -&gt; 401 y la funcion no se ejecuta.&#xa;Son cero lineas de codigo propio: no hay que&#xa;descargar claves, ni cachearlas, ni rotarlas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v_fn" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_fn" value="Lambda bookslot-api&#xa;&#xa;Recibe las claims ya validadas y decide:&#xa;&#xa;    · la identidad sale del token (sub), nunca&#xa;      de la URL ni del cuerpo&#xa;    · /admin/** exige el grupo admins, leido de&#xa;      cognito:groups&#xa;    · el resto opera solo sobre los datos del&#xa;      propio usuario&#xa;&#xa;El perfil se crea solo en la primera peticion&#xa;autenticada, leyendo sub, email y name del token." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="540" y="560" width="420" height="232" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="usuario y contrasena" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_nav" target="p_cog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_cog" target="p_nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Authorization: Bearer &amp;lt;JWT&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_nav" target="p_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="descarga el JWKS (en cache)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;dashed=1;endArrow=open;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_gw" target="p_cog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="las claims, ya validadas" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;rounded=0;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="p_gw" target="p_fn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_rutas" value="LAS RUTAS, POR NIVEL DE ACCESO&#xa;&#xa;PUBLICAS · declaradas sin authorizer&#xa;    GET /resources&#xa;    GET /resources/{resourceId}&#xa;    GET /slots&#xa;&#xa;AUTENTICADAS · exigen un token valido&#xa;    POST /reservations&#xa;    GET /reservations&#xa;    DELETE /reservations/{slotId}&#xa;    GET /me · PUT /me&#xa;&#xa;ADMIN · token valido + grupo admins&#xa;    POST /admin/resources&#xa;    POST /admin/slots" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="400" height="320" as="geometry" />
        </mxCell>
        <mxCell id="p_elim" value="LO QUE ESTE REPARTO ELIMINA&#xa;&#xa;· La funcion no necesita NI UN permiso de Cognito:&#xa;  no llama a SignUp, ni a InitiateAuth, ni a GetUser.&#xa;&#xa;· No hay validacion de JWKS escrita a mano, ni cache&#xa;  de claves, ni Spring Security.&#xa;&#xa;· No hay rutas /auth/*: el registro y el acceso no&#xa;  pasan por la API.&#xa;&#xa;· Una contrasena nunca llega al codigo propio." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#232F3E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="540" width="400" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tabla" name="4 · La tabla en DynamoDB">
    <mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_tabla" value="BookSlot — una sola tabla" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_tabla" value="Cinco tipos de item conviven en la misma tabla. Solo se declaran los atributos que son CLAVE: fuera de ellas, DynamoDB no tiene esquema." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ic_ddb" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cab0" value="Item" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="110" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cab1" value="PK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cab2" value="SK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="110" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cab3" value="GSI1PK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5A2D6E;strokeColor=#5A2D6E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="110" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cab4" value="GSI1SK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5A2D6E;strokeColor=#5A2D6E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="110" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f0c0" value="Recurso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
